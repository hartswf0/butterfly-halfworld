node_modules/
.DS_Store
harness/.gemini-key
harness/.voice-state.json
audio/scenes/*.wav
audio/master.wav
film/.tmp/
.claude-serve.txt

film/.tmpclose/

film/.measure/
node_modules/
package-lock.json

# rendered suite films — outputs, rebuilt by wygwyl/render-film.mjs
film/WYGWYL*.mp4

# per-frame QA renders — regenerated by wygwyl/shoot.mjs on demand, hundreds of
# them, and none is a source. The contact sheet IS kept: it is the one image
# that says something about the whole suite at once.
renders/wygwyl/*.png
!renders/wygwyl/CONTACT.png
renders/wygwyl/dj-*.png
renders/wygwyl/_*.png

# agent worktrees are their own repositories
.claude/worktrees/

# agent scratch shooters
.at-tmp.mjs

# WORKING RENDERS ARE OUTPUTS, NOT FILES IN THE REPOSITORY.
# The pages are the work and the pictures come out of the pages. Anything
# under renders/ whose directory name starts with an underscore is a scratch
# pile from a shoot, a frame dump, or a still pulled out of a finished film to
# look at — it is how the work was checked, not the work.
renders/wygwyl/_*/
renders/outoflife/

# carve outputs — sheets and strips are how a source was looked at, not the work
renders/carve/

# the motion benchmark is generated, not stored
renders/benchmark/
renders/see/
renders/deep/

# cut sheets and song maps — outputs of wygwyl/cut/analyse.mjs, regenerated by
# pointing it at a folder of audio. The demo runs here are of pieces the repo
# already contains; the real ones will be of songs it does not.
renders/cut/

# AUDIO/plates is derived: 1,095 five-plane radiographs regenerated by
# cut/pf/audio_scan.py in about half an hour. They are committed as WebP (~45MB)
# rather than gitignored, because an atlas with no plates is not an atlas — but
# if they ever grow past what a repo should carry, this is the line to add:
# AUDIO/plates/

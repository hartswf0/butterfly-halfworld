{"film": "film/BUTTERFLY.mp4", "total": 485.6, "scenes": [{"id": "C00", "t0": 0.0, "dur": 6, "card": true, "why": "the mark draws itself before anything is named", "voiceSec": 0}, {"id": "C01", "t0": 6.0, "dur": 7.5, "card": true, "why": "the older question, before the film answers it in the affirmative", "voiceSec": 0}, {"id": "P00", "t0": 13.5, "dur": 1.8, "card": true, "why": "where we are: the observation box", "voiceSec": 0}, {"id": "C02", "t0": 15.3, "dur": 8, "card": true, "why": "you cannot read a refusal without the two choices it declines", "voiceSec": 0}, {"id": "BF-01", "t0": 23.3, "dur": 12, "card": false, "why": "", "voiceSec": 9.411, "bed": {"file": "pack/songloops/VOL_glass-15_06.mp3", "name": "VOL_GLASS15_PIANO_2", "genre": "WARM"}}, {"id": "P01", "t0": 35.3, "dur": 1.8, "card": true, "why": "where we are: the laboratory", "voiceSec": 0}, {"id": "BF-02", "t0": 37.1, "dur": 5, "card": false, "why": "", "voiceSec": 2.291}, {"id": "BF-03", "t0": 42.1, "dur": 10, "card": false, "why": "", "voiceSec": 8.611, "bed": {"file": "pack/songloops/VOL_dustrest-10_08.mp3", "name": "VOL_DUSTREST10_PIANO_7", "genre": "WARM"}}, {"id": "BF-04", "t0": 52.1, "dur": 4.5, "card": false, "why": "", "voiceSec": 0}, {"id": "BF-05", "t0": 56.6, "dur": 10, "card": false, "why": "", "voiceSec": 9.731, "bed": {"file": "pack/songloops/VOL_dustrest-16_02.mp3", "name": "VOL_DUSTREST16_SYNTHLEAD_2", "genre": "WARM"}}, {"id": "BF-06", "t0": 66.6, "dur": 15, "card": false, "why": "", "voiceSec": 11.611, "bed": {"file": "pack/songloops/VOL_dustrest-10_05.mp3", "name": "VOL_DUSTREST10_PIANO_4", "genre": "WARM"}}, {"id": "BF-07", "t0": 81.6, "dur": 4, "card": false, "why": "", "voiceSec": 3.371}, {"id": "C03", "t0": 85.6, "dur": 7, "card": true, "why": "after the scales are on her hand: why the smell is the kindest one available", "voiceSec": 0}, {"id": "BF-08", "t0": 92.6, "dur": 6, "card": false, "why": "", "voiceSec": 0}, {"id": "BF-09", "t0": 98.6, "dur": 11, "card": false, "why": "", "voiceSec": 6.491, "bed": {"file": "pack/songloops/VOL_mareamemory-02_02.mp3", "name": "VOL_MAREAMEMORY02_PIANO_2", "genre": "WARM"}}, {"id": "BF-10", "t0": 109.6, "dur": 16.5, "card": false, "why": "", "voiceSec": 12.571, "bed": {"file": "pack/songloops/VOL_dustrest-16_08.mp3", "name": "VOL_DUSTREST16_SYNTHLEAD_6", "genre": "WARM"}}, {"id": "BF-11", "t0": 126.1, "dur": 16, "card": false, "why": "", "voiceSec": 14.211, "bed": {"file": "pack/songloops/VOL_dustrest-10_06.mp3", "name": "VOL_DUSTREST10_PIANO_5", "genre": "WARM"}}, {"id": "BF-12", "t0": 142.1, "dur": 4, "card": false, "why": "", "voiceSec": 3.291}, {"id": "BF-13", "t0": 146.1, "dur": 33, "card": false, "why": "", "voiceSec": 29.891, "bed": {"file": "pack/songloops/VOL_mallground-27_08.mp3", "name": "VOL_MALLGROUND27_PIANO_4", "genre": "WARM"}}, {"id": "BF-14", "t0": 179.1, "dur": 4, "card": false, "why": "", "voiceSec": 0}, {"id": "P02", "t0": 183.1, "dur": 1.8, "card": true, "why": "where we are: the mill", "voiceSec": 0}, {"id": "BF-15", "t0": 184.9, "dur": 3, "card": false, "why": "", "voiceSec": 2.651}, {"id": "BF-16", "t0": 187.9, "dur": 5, "card": false, "why": "", "voiceSec": 0}, {"id": "C04", "t0": 192.9, "dur": 6.5, "card": true, "why": "before Iona arrives: someone did this, and was doubted", "voiceSec": 0}, {"id": "BF-17", "t0": 199.4, "dur": 15, "card": false, "why": "", "voiceSec": 11.891, "bed": {"file": "pack/songloops/VOL_glass-15_08.mp3", "name": "VOL_GLASS15_PADCHORD_3", "genre": "WARM"}}, {"id": "BF-18", "t0": 214.4, "dur": 13.5, "card": false, "why": "", "voiceSec": 9.891, "bed": {"file": "pack/songloops/VOL_mallground-27_08.mp3", "name": "VOL_MALLGROUND27_PIANO_4", "genre": "WARM"}}, {"id": "BF-19", "t0": 227.9, "dur": 12, "card": false, "why": "", "voiceSec": 9.891, "bed": {"file": "pack/songloops/VOL_mallground-27_06.mp3", "name": "VOL_MALLGROUND27_GUITAR_1", "genre": "WARM"}}, {"id": "BF-20", "t0": 239.9, "dur": 3.5, "card": false, "why": "", "voiceSec": 0}, {"id": "BF-21", "t0": 243.4, "dur": 8, "card": false, "why": "", "voiceSec": 4.051, "bed": {"file": "pack/songloops/VOL_mareamemory-02_04.mp3", "name": "VOL_MAREAMEMORY02_PIANO_4", "genre": "WARM"}}, {"id": "BF-22", "t0": 251.4, "dur": 20, "card": false, "why": "", "voiceSec": 16.811, "bed": {"file": "pack/songloops/VOL_aeolian-02_02.mp3", "name": "VOL_AEOLIAN02_SYNTHLEAD_2", "genre": "WARM"}}, {"id": "BF-23", "t0": 271.4, "dur": 4.5, "card": false, "why": "", "voiceSec": 0}, {"id": "BF-24", "t0": 275.9, "dur": 8, "card": false, "why": "", "voiceSec": 6.571, "bed": {"file": "pack/songloops/VOL_dustrest-11_04.mp3", "name": "VOL_DUSTREST11_PIANO_3", "genre": "WARM"}}, {"id": "BF-25", "t0": 283.9, "dur": 10, "card": false, "why": "", "voiceSec": 5.131, "bed": {"file": "pack/songloops/VOL_dustrest-10_07.mp3", "name": "VOL_DUSTREST10_PIANO_6", "genre": "WARM"}}, {"id": "P03", "t0": 293.9, "dur": 1.8, "card": true, "why": "where we are: the lot", "voiceSec": 0}, {"id": "BF-26", "t0": 295.7, "dur": 11, "card": false, "why": "", "voiceSec": 6.811, "bed": {"file": "pack/songloops/VOL_dustrest-10_04.mp3", "name": "VOL_DUSTREST10_PIANO_3", "genre": "WARM"}}, {"id": "BF-27", "t0": 306.7, "dur": 15, "card": false, "why": "", "voiceSec": 11.811, "bed": {"file": "pack/songloops/VOL_glass-15_08.mp3", "name": "VOL_GLASS15_PADCHORD_3", "genre": "WARM"}}, {"id": "BF-28", "t0": 321.7, "dur": 5.5, "card": false, "why": "", "voiceSec": 4.971}, {"id": "P04", "t0": 327.2, "dur": 1.8, "card": true, "why": "where we are: the rearing facility", "voiceSec": 0}, {"id": "BF-29", "t0": 329.0, "dur": 13.5, "card": false, "why": "", "voiceSec": 9.842, "bed": {"file": "pack/songloops/VOL_dustrest-11_06.mp3", "name": "VOL_DUSTREST11_PIANO_5", "genre": "WARM"}}, {"id": "BF-30", "t0": 342.5, "dur": 10, "card": false, "why": "", "voiceSec": 7.491, "bed": {"file": "pack/songloops/VOL_dustrest-19_02.mp3", "name": "VOL_DUSTREST19_PIANO_1", "genre": "WARM"}}, {"id": "BF-31", "t0": 352.5, "dur": 8, "card": false, "why": "", "voiceSec": 7.882, "bed": {"file": "pack/songloops/VOL_glass-06_03.mp3", "name": "VOL_GLASS06_PIANO_2", "genre": "WARM"}}, {"id": "BF-32", "t0": 360.5, "dur": 10, "card": false, "why": "", "voiceSec": 6.691, "bed": {"file": "pack/songloops/VOL_glass-15_04.mp3", "name": "VOL_GLASS15_PIANO_1", "genre": "WARM"}}, {"id": "BF-33", "t0": 370.5, "dur": 5.5, "card": false, "why": "", "voiceSec": 4.611}, {"id": "BF-34", "t0": 376.0, "dur": 5, "card": false, "why": "", "voiceSec": 2.691}, {"id": "BF-35", "t0": 381.0, "dur": 6, "card": false, "why": "", "voiceSec": 3.411}, {"id": "BF-36", "t0": 387.0, "dur": 3.5, "card": false, "why": "", "voiceSec": 0}, {"id": "BF-37", "t0": 390.5, "dur": 4, "card": false, "why": "", "voiceSec": 0}, {"id": "BF-38", "t0": 394.5, "dur": 5.5, "card": false, "why": "", "voiceSec": 0}, {"id": "BF-39", "t0": 400.0, "dur": 5.5, "card": false, "why": "", "voiceSec": 3.971}, {"id": "BF-40", "t0": 405.5, "dur": 5.5, "card": false, "why": "", "voiceSec": 3.611}, {"id": "C05", "t0": 411.0, "dur": 7, "card": true, "why": "the last word, and it is a chrysalis", "voiceSec": 0}, {"id": "CREDITS", "t0": 418.0, "dur": 67.6, "card": true, "why": "the end roll: who the film stands on, where it departs from them, and which of its facts is contested", "voiceSec": 0}], "cuts": [{"t": 0, "kind": "wide", "label": "C00"}, {"t": 6, "kind": "wide", "label": "C01"}, {"t": 13.5, "kind": "wide", "label": "P00"}, {"t": 15.3, "kind": "wide", "label": "C02"}, {"t": 23.3, "kind": "wide", "label": "BF-01"}, {"t": 35.3, "kind": "wide", "label": "P01"}, {"t": 37.1, "kind": "wide", "label": "BF-02"}, {"t": 42.1, "kind": "close", "label": "NIKO · CU-BF-03-0-0-intro"}, {"t": 43.84, "kind": "wide", "label": "BF-03"}, {"t": 46.48, "kind": "close", "label": "MARA · CU-BF-03-0-3-intro"}, {"t": 48.5, "kind": "wide", "label": "BF-03"}, {"t": 52.1, "kind": "wide", "label": "BF-04"}, {"t": 56.6, "kind": "wide", "label": "BF-05"}, {"t": 63.61, "kind": "close", "label": "MARA · CU-BF-05-0-3"}, 
"kind": "wide", "label": "BF-24"}, {"t": 279.64, "kind": "close", "label": "NIKO · CU-BF-24-0-1"}, {"t": 281.67, "kind": "wide", "label": "BF-24"}, {"t": 283.9, "kind": "wide", "label": "BF-25"}, {"t": 293.9, "kind": "wide", "label": "P03"}, {"t": 295.7, "kind": "wide", "label": "BF-26"}, {"t": 306.7, "kind": "wide", "label": "BF-27"}, {"t": 315.46, "kind": "close", "label": "IONA · CU-BF-27-0-5"}, {"t": 317.71, "kind": "wide", "label": "BF-27"}, {"t": 321.7, "kind": "wide", "label": "BF-28"}, {"t": 327.2, "kind": "wide", "label": "P04"}, {"t": 329, "kind": "wide", "label": "BF-29"}, {"t": 336.6, "kind": "close", "label": "IONA · CU-BF-29-1-1-react-niko"}, {"t": 339.64, "kind": "wide", "label": "BF-29"}, {"t": 342.5, "kind": "wide", "label": "BF-30"}, {"t": 346.36, "kind": "close", "label": "IONA · CU-BF-30-0-1"}, {"t": 349.19, "kind": "wide", "label": "BF-30"}, {"t": 352.5, "kind": "wide", "label": "BF-31"}, {"t": 360.5, "kind": "wide", "label": "BF-32"}, {"t": 370.5, "kind": "wide", "label": "BF-33"}, {"t": 376, "kind": "wide", "label": "BF-34"}, {"t": 381, "kind": "wide", "label": "BF-35"}, {"t": 387, "kind": "wide", "label": "BF-36"}, {"t": 390.5, "kind": "wide", "label": "BF-37"}, {"t": 394.5, "kind": "wide", "label": "BF-38"}, {"t": 400, "kind": "wide", "label": "BF-39"}, {"t": 405.5, "kind": "wide", "label": "BF-40"}, {"t": 411, "kind": "wide", "label": "C05"}, {"t": 418, "kind": "wide", "label": "CREDITS"}], "lines": [{"t0": 23.3, "dur": 2.54, "who": "VO", "text": "I remember being a butterfly."}, {"t0": 25.84, "dur": 4.5, "who": "VO", "text": "I remember the roof as a brightness I could not enter."}, {"t0": 30.34, "dur": 1.57, "who": "VO", "text": "I did not choose."}, {"t0": 37.1, "dur": 1.49, "who": "NIKO", "text": "Stop the trial."}, {"t0": 42.1, "dur": 1.74, "who": "NIKO", "text": "Stop means stop."}, {"t0": 43.84, "dur": 0.84, "who": "MARA", "text": "It's stopped."}, {"t0": 44.68, "dur": 1.8, "who": "NIKO", "text": "The odor is stopped."}, {"t0": 46.48, "dur": 2.02, "who": "MARA", "text": "That's what I meant."}, {"t0": 48.5, "dur": 1.41, "who": "NIKO", "text": "No, it isn't."}, {"t0": 56.6, "dur": 2.1, "who": "NIKO", "text": "Trial 6F-19. Non-completion."}, {"t0": 58.7, "dur": 1.51, "who": "MARA", "text": "It completed something."}, {"t0": 60.21, "dur": 3.4, "who": "NIKO", "text": "It chose the ceiling?"}, {"t0": 63.61, "dur": 1.92, "who": "MARA", "text": "It rejected the premise."}, {"t0": 66.6, "dur": 2.66, "who": "MARA", "text": "Delete the path visualization."}, {"t0": 69.26, "dur": 2.12, "who": "NIKO", "text": "The path is the record."}, {"t0": 71.38, "dur": 2.19, "who": "MARA", "text": "The arm choice is the record."}, {"t0": 73.57, "dur": 2.03, "who": "NIKO", "text": "It didn't choose an arm."}, {"t0": 75.6, "dur": 1.81, "who": "MARA", "text": "Then the trial failed."}, {"t0": 81.6, "dur": 1.31, "who": "NIKO", "text": "What is that?"}, {"t0": 82.91, "dur": 1.26, "who": "MARA", "text": "Wing scale."}, {"t0": 98.6, "dur": 1.21, "who": "NIKO", "text": "Who are they?"}, {"t0": 99.8, "dur": 1.17, "who": "MARA", "text": "I don't know."}, {"t0": 100.97, "dur": 0.94, "who": "NIKO", "text": "Family?"}, {"t0": 101.91, "dur": 2.38, "who": "MARA", "text": "The woman is supposed to be my grandmother."}, {"t0": 109.6, "dur": 3.01, "who": "NIKO", "text": "Your mother was alive in 1945?"}, {"t0": 112.61, "dur": 0.84, "who": "MARA", "text": "No."}, {"t0": 113.45, "dur": 2.55, "who": "MARA", "text": "My mother was born in 1963."}, {"t0": 116.0, "dur": 2.03, "who": "NIKO", "text": "Then Elise isn't your mother."}, {"t0": 118.03, "dur": 1.24, "who": "MARA", "text": "It was her name."}, {"t0": 119.27, "dur": 2.1, "who": "MARA", "text": "She said she remembered being there."}, {"t0": 126.1, "dur": 2.38, "who": "NIKO", "text": "Could it have gotten into the intake?"}, {"t0": 128.47, "dur": 1.77, "who": "MARA", "text": "The sensor would have caught it."}, {"t0": 130.25, "dur": 1.89, "who": "NIKO", "text": "Could the sensor be wrong?"}, {"t0": 132.13, "dur": 0.95, "who": "MARA", "text": "Yes."}, {"t0": 133.09, "dur": 1.85, "who": "NIKO", "text": "Could the cleaning have failed?"}, {"t0": 134.94, "dur": 1.02, "who": "MARA", "text": "Yes."}, {"t0": 135.96, "dur": 3.55, "who": "NIKO", "text": "Then why are we looking at a photograph from 1945?"}, {"t0": 142.1, "dur": 1.65, "who": "NIKO", "text": "Was that there before?"}, {"t0": 143.75, "dur": 0.85, "who": "MARA", "text": "No."}, {"t0": 146.1, "dur": 3.37, "who": "IONA (V.O.)", "text": "You opened the lavender."}, {"t0": 149.47, "dur": 16.96, "who": "IONA (V.O.)", "text": "You always open it too early. Your mother did. Her mother did. The insects wake before the story is ready for them."}, {"t0": 166.43, "dur": 8.76, "who": "IONA (V.O.)", "text": "I found the boy. He has been dead for eleven years."}, {"t0": 184.9, "dur": 1.85, "who": "MARA", "text": "Call building security."}, {"t0": 199.4, "dur": 1.99, "who": "IONA", "text": "You have her shoulders."}, {"t0": 201.39, "dur": 1.85, "who": "MARA", "text": "Are you Iona Ash?"}, {"t0": 203.24, "dur": 2.77, "who": "IONA", "text": "That depends which paper you're reading."}, {"t0": 206.02, "dur": 1.62, "who": "MARA", "text": "My mother is dead."}, {"t0": 207.63, "dur": 2.86, "who": "IONA", "text": "Yes. That was what made it difficult."}, {"t0": 214.4, "dur": 1.78, "who": "IONA", "text": "I brought you the film."}, {"t0": 216.19, "dur": 2.01, "who": "MARA", "text": "Where did these come from?"}, {"t0": 218.19, "dur": 1.11, "who": "IONA", "text": "The envelope."}, {"t0": 219.31, "dur": 2.27, "who": "MARA", "text": "Was there a butterfly in it?"}, {"t0": 221.59, "dur": 1.91, "who": "IONA", "text": "Not when I closed it."}, {"t0": 227.9, "dur": 2.32, "who": "IONA", "text": "You work for the clean version."}, {"t0": 230.22, "dur": 1.7, "who": "NIKO", "text": "And you work for what?"}, {"t0": 231.91, "dur": 2.02, "who": "IONA", "text": "The version that survived."}, {"t0": 233.93, "dur": 3.06, "who": "NIKO", "text": "This is exactly how contamination happens."}, {"t0": 243.4, "dur": 1.31, "who": "NIKO", "text": "Put it down."}, {"t0": 244.72, "dur": 1.94, "who": "NIKO", "text": "That isn't possible."}, {"t0": 251.4, "dur": 4.84, "who": "IONA", "text": "The first time you see it, you will think the picture is remembering the event."}, {"t0": 256.25, "dur": 5.07, "who": "IONA", "text": "The second time, you will think the event was arranged to resemble the picture."}, {"t0": 261.31, "dur": 2.48, "who": "IONA", "text": "Do not watch it a third time."}, {"t0": 263.79, "dur": 0.99, "who": "MARA", "text": "Why?"}, {"t0": 264.79, "dur": 2.63, "who": "IONA", "text": "Because then you will remember being there."}, {"t0": 275.9, "dur": 3.75, "who": "IONA", "text": "Now you understand why it cannot be photographed."}, {"t0": 279.64, "dur": 2.03, "who": "NIKO", "text": "Of course it can be photographed."}, {"t0": 283.9, "dur": 1.22, "who": "MARA", "text": "Open the door."}, {"t0": 285.12, "dur": 1.62, "who": "NIKO", "text": "If it gets outside—"}, {"t0": 286.75, "dur": 1.49, "who": "MARA", "text": "It will kill itself."}, {"t0": 295.7, "dur": 1.7, "who": "MARA", "text": "Where is it going?"}, {"t0": 297.39, "dur": 1.11, "who": "IONA", "text": "To the boy."}, {"t0": 298.51, "dur": 1.47, "who": "MARA", "text": "You said he's dead."}, {"t0": 299.97, "dur": 1.74, "who": "IONA", "text": "I said we found him."}, {"t0": 306.7, "dur": 1.74, "who": "MARA", "text": "It isn't afraid."}, {"t0": 308.44, "dur": 1.36, "who": "IONA", "text": "Why would it be?"}, {"t0": 309.8, "dur": 1.46, "who": "MARA", "text": "Our colony—"}, {"t0": 311.26, "dur": 1.81, "who": "IONA", "text": "Your colony was taught."}, {"t0": 313.07, "dur": 2.4, "who": "MARA", "text": "This one has the same marking."}, {"t0": 315.46, "dur": 2.25, "who": "IONA", "text": "Marking is not memory."}, {"t0": 321.7, "dur": 1.99, "who": "NIKO", "text": "That wasn't here last week."}, {"t0": 323.69, "dur": 1.19, "who": "MARA", "text": "You come here?"}, {"t0": 324.88, "dur": 1.0, "who": "NIKO", "text": "Lunch."}, {"t0": 329.0, "dur": 2.04, "who": "NIKO", "text": "This is a rearing facility."}, {"t0": 329.0, "dur": 1.6, "who": "MARA", "text": "You built this."}, {"t0": 330.61, "dur": 1.45, "who": "IONA", "text": "I remembered it."}, {"t0": 331.04, "dur": 0.89, "who": "IONA", "text": "No."}, {"t0": 331.93, "dur": 2.57, "who": "IONA", "text": "This is the part that keeps reappearing."}, {"t0": 342.5, "dur": 2.67, "who": "NIKO", "text": "Someone has been running experiments here."}, {"t0": 345.17, "dur": 1.19, "who": "NIKO", "text": "How many?"}, {"t0": 346.36, "dur": 2.84, "who": "IONA", "text": "Enough to keep it from becoming evidence."}, {"t0": 352.5, "dur": 1.47, "who": "NIKO", "text": "What did you see?"}, {"t0": 352.5, "dur": 3.57, "who": "IONA", "text": "You saw yourself arranged as a memory."}, {"t0": 353.96, "dur": 1.55, "who": "MARA", "text": "I saw today."}, {"t0": 360.5, "dur": 1.35, "who": "NIKO", "text": "Temperature change?"}, {"t0": 361.85, "dur": 0.85, "who": "MARA", "text": "No."}, {"t0": 362.7, "dur": 1.03, "who": "NIKO", "text": "Vibration?"}, {"t0": 363.74, "dur": 0.83, "who": "MARA", "text": "No."}, {"t0": 364.57, "dur": 1.82, "who": "NIKO", "text": "You have to give me something."}, {"t0": 370.5, "dur": 1.63, "who": "MARA", "text": "Who is filming?"}, {"t0": 372.13, "dur": 2.18, "who": "IONA", "text": "The person who remembers."}, {"t0": 376.0, "dur": 1.89, "who": "ELISE (V.O.)", "text": "Do not turn around."}, {"t0": 381.0, "dur": 2.61, "who": "PROJECTED MARA", "text": "I remember being a butterfly."}, {"t0": 400.0, "dur": 2.17, "who": "IONA (O.S.)", "text": "You see why it survives."}, {"t0": 402.17, "dur": 1.0, "who": "NIKO", "text": "Mara."}, {"t0": 405.5, "dur": 2.81, "who": "THE GIRL", "text": "Someone is still inside."}], "silences": [{"t0": 0.0, "dur": 23.3}, {"t0": 31.91, "dur": 5.19}, {"t0": 38.59, "dur": 3.51}, {"t0": 49.91, "dur": 6.69}, {"t0": 77.41, "dur": 4.19}, {"t0": 84.17, "dur": 14.43}, {"t0": 104.29, "dur": 5.31}, {"t0": 121.37, "dur": 4.73}, {"t0": 139.51, "dur": 2.59}, {"t0": 144.6, "dur": 1.5}, {"t0": 175.19, "dur": 9.71}, {"t0": 186.75, "dur": 12.65}, {"t0": 210.49, "dur": 3.91}, {"t0": 223.5, "dur": 4.4}, {"t0": 236.99, "dur": 6.41}, {"t0": 246.66, "dur": 4.74}, {"t0": 267.42, "dur": 8.48}, {"t0": 281.67, "dur": 2.23}, {"t0": 288.24, "dur": 7.46}, {"t0": 301.71, "dur": 4.99}, {"t0": 317.71, "dur": 3.99}, {"t0": 325.88, "dur": 3.12}, {"t0": 334.5, "dur": 8.0}, {"t0": 349.2, "dur": 3.3}, {"t0": 356.07, "dur": 4.43}, {"t0": 366.39, "dur": 4.11}, {"t0": 374.31, "dur": 1.69}, {"t0": 377.89, "dur": 3.11}, {"t0": 383.61, "dur": 16.39}, {"t0": 403.17, "dur": 2.33}, {"t0": 408.31, "dur": 77.29}], "pools": {"hits": [{"file": "pack/audio/ATL_HIT_WHEREYOUGOWHEN_01.mp3", "label": "hit whereyougowhen 01", "dur": 1.51}, {"file": "pack/audio/ATL_HIT_RESURRECTINGAT_03.mp3", "label": "hit resurrectingat 03", "dur": 1.04}, {"file": "pack/audio/ATL_HIT_WHEREYOUGOWHEN_06.mp3", "label": "hit whereyougowhen 06", "dur": 1.6}, {"file": "pack/audio/ATL_HIT_05BLOODLINEMIX_09.mp3", "label": "hit 05bloodlinemix 09", "dur": 1.25}, {"file": "pack/audio/ATL_HIT_05BLOODLINEMIX_10.mp3", "label": "hit 05bloodlinemix 10", "dur": 1.25}, {"file": "pack/audio/ATL_HIT_05BLOODLINEMIX_14.mp3", "label": "hit 05bloodlinemix 14", "dur": 0.88}, {"file": "pack/audio/ATL_HIT_WHEREYOUGOWHEN_15.mp3", "label": "hit whereyougowhen 15", "dur": 1.16}, {"file": "pack/audio/ATL_HIT_05BLOODLINEMIX_16.mp3", "label": "hit 05bloodlinemix 16", "dur": 0.88}, {"file": "pack/audio/ATL_HIT_01OUTOFLIFEMIX_17.mp3", "label": "hit 01outoflifemix 17", "dur": 1.25}, {"file": "pack/audio/ATL_HIT_COMBINEDMIXDOW_18.mp3", "label": "hit combinedmixdow 18", "dur": 1.3}, {"file": "pack/audio/ATL_HIT_01OUTOFLIFEMIX_19.mp3", "label": "hit 01outoflifemix 19", "dur": 1.25}, {"file": "pack/audio/ATL_HIT_COMBINEDMIXDOW_20.mp3", "label": "hit combinedmixdow 20", "dur": 1.3}, {"file": "pack/audio/ATL_HIT_05BLOODLINEMIX_22.mp3", "label": "hit 05bloodlinemix 22", "dur": 1.46}, {"file": "pack/audio/ATL_HIT_05BLOODLINEMIX_23.mp3", "label": "hit 05bloodlinemix 23", "dur": 1.46}, {"file": "pack/audio/ATL_HIT_12REUNIONMIXDO_25.mp3", "label": "hit 12reunionmixdo 25", "dur": 1.18}, {"file": "pack/audio/ATL_HIT_COMBINEDMIXDOW_26.mp3", "label": "hit combinedmixdow 26", "dur": 0.91}, {"file": "pack/audio/ATL_HIT_COMBINEDMIXDOW_27.mp3", "label": "hit combinedmixdow 27", "dur": 0.91}, {"file": "pack/audio/ATL_HIT_12REUNIONMIXDO_28.mp3", "label": "hit 12reunionmixdo 28", "dur": 1.18}, {"file": "pack/audio/ATL_HIT_06RESURRECTING_29.mp3", "label": "hit 06resurrecting 29", "dur": 0.84}, {"file": "pack/audio/ATL_HIT_06RESURRECTING_30.mp3", "label": "hit 06resurrecting 30", "dur": 0.84}], "whispers": [{"file": "codex/01/line_00.mp3", "text": "What we've made we don't want, what we've sold to the world, to ", "dur": 9.69, "kind": "sung", "poem": "Out of Life"}, {"file": "codex/01/line_03.mp3", "text": "It was the maze constructed by a tainted love, a known yet unkno", "dur": 7.45, "kind": "sung", "poem": "Out of Life"}, {"file": "codex/02/line_00.mp3", "text": "I heard a scream for help while falling with my headlights off.", "dur": 6.44, "kind": "sung", "poem": "Flashing Lights"}, {"file": "codex/02/line_08.mp3", "text": "I was six I recall when the ghost of a dead and loveless seven-y", "dur": 9.32, "kind": "sung", "poem": "Flashing Lights"}, {"file": "codex/03/line_06.mp3", "text": "and a tambourine shattered into pieces.", "dur": 4.61, "kind": "sung", "poem": "How to Break off an Engagement"}, {"file": "codex/03/line_02.mp3", "text": "Spirits have left salvations and opened gift boxes placed outsid", "dur": 8.35, "kind": "sung", "poem": "How to Break off an Engagement"}, {"file": "codex/04/line_01.mp3", "text": "cover sands and debris", "dur": 2.25, "kind": "sung", "poem": "Nevermore"}, {"file": "codex/04/line_10.mp3", "text": "as I'm called forward.", "dur": 1.73, "kind": "sung", "poem": "Nevermore"}, {"file": "codex/05/line_00.mp3", "text": "They tell me to ask if I can inherit the earth,", "dur": 5.81, "kind": "sung", "poem": "Bloodline"}, {"file": "codex/05/line_01.mp3", "text": "to ask if I can name my own stars, even galaxies if I may.", "dur": 5.91, "kind": "sung", "poem": "Bloodline"}, {"file": "codex/06/line_02.mp3", "text": "color rainbows, and give us infinite time to heal and set clouds", "dur": 6.49, "kind": "sung", "poem": "Resurrecting Atlantis"}, {"file": "codex/06/line_00.mp3", "text": "The gates open with wings gifted from evolution, and made of mar", "dur": 4.31, "kind": "sung", "poem": "Resurrecting Atlantis"}, {"file": "codex/07/line_05.mp3", "text": "or a frontal fog or of dim night lights under a cloud with the s", "dur": 7.85, "kind": "sung", "poem": "DJ Turn Me Up"}, {"file": "codex/07/line_04.mp3", "text": "we love we not. Of a future gone swiftly and a past left empty h", "dur": 7.69, "kind": "sung", "poem": "DJ Turn Me Up"}, {"file": "codex/08/line_00.mp3", "text": "The soul has escaped my body for the moment and left him on the ", "dur": 4.25, "kind": "sung", "poem": "Newly Single"}, {"file": "codex/08/line_06.mp3", "text": "in the distance and wandering eyes and wandering thoughts within", "dur": 3.73, "kind": "sung", "poem": "Newly Single"}, {"file": "codex/09/line_04.mp3", "text": "I believe maybe we could have it all,", "dur": 3.59, "kind": "sung", "poem": "Yet Heard"}, {"file": "codex/09/line_10.mp3", "text": "the way we used to be.", "dur": 2.64, "kind": "sung", "poem": "Yet Heard"}, {"file": "codex/10/line_02.mp3", "text": "So I rub my aggressions into your steel coverings and hop on to ", "dur": 7.17, "kind": "sung", "poem": "Magic Ride"}, {"file": "codex/10/line_03.mp3", "text": "Loneliness is having everything with no one to tell,", "dur": 4.57, "kind": "sung", "poem": "Magic Ride"}, {"file": "codex/12/line_00.mp3", "text": "Decades later, there was less time for words and more space for ", "dur": 11.17, "kind": "sung", "poem": "Reunion"}, {"file": "codex/12/line_01.mp3", "text": "loud voices so our hearts can be overheard. My mind drifts into ", "dur": 14.0, "kind": "sung", "poem": "Reunion"}, {"file": "codex/13/line_05.mp3", "text": "So I thought, life has burned all of my love stories.", "dur": 5.4, "kind": "sung", "poem": "How to Win My Heart"}, {"file": "codex/13/line_12.mp3", "text": "stepping back and letting them say hello,", "dur": 3.97, "kind": "sung", "poem": "How to Win My Heart"}, {"file": "codex/14/line_03.mp3", "text": "Whatever has terminated this moment, damn you,", "dur": 4.09, "kind": "sung", "poem": "Hot Minute"}, {"file": "codex/14/line_00.mp3", "text": "Don't make me leave and go where promises, hearts,", "dur": 2.97, "kind": "sung", "poem": "Hot Minute"}, {"file": "chops/01/01_C24.mp3", "text": "love and", "dur": 2.5, "kind": "spoken", "poem": "Out of Life"}, {"file": "chops/02/02_C02.mp3", "text": "type of silent", "dur": 2.5, "kind": "spoken", "poem": "Flashing Lights"}, {"file": "chops/03/03_C25.mp3", "text": "old to", "dur": 2.5, "kind": "spoken", "poem": "How to Break off an Engagement"}, {"file": "chops/04/04_C01.mp3", "text": "if I follow", "dur": 2.5, "kind": "spoken", "poem": "Nevermore"}, {"file": "chops/05/05_C01.mp3", "text": "to ask if", "dur": 2.5, "kind": "spoken", "poem": "Bloodline"}, {"file": "chops/06/06_C28.mp3", "text": "my soul", "dur": 2.5, "kind": "spoken", "poem": "Resurrecting Atlantis"}, {"file": "chops/07/07_C16.mp3", "text": "Of a", "dur": 2.5, "kind": "spoken", "poem": "DJ Turn Me Up"}, {"file": "chops/08/08_C21.mp3", "text": "my body", "dur": 2.5, "kind": "spoken", "poem": "Newly Single"}, {"file": "chops/09/09_C21.mp3", "text": "my own,", "dur": 2.5, "kind": "spoken", "poem": "Yet Heard"}, {"file": "chops/10/10_C28.mp3", "text": "I want", "dur": 2.5, "kind": "spoken", "poem": "Magic Ride"}, {"file": "chops/11/11_C14.mp3", "text": "new day.", "dur": 2.5, "kind": "spoken", "poem": "New Day"}, {"file": "chops/12/12_C10.mp3", "text": "into the", "dur": 2.5, "kind": "spoken", "poem": "Reunion"}, {"file": "chops/13/13_C01.mp3", "text": "I want", "dur": 2.5, "kind": "spoken", "poem": "How to Win My Heart"}, {"file": "chops/14/14_C10.mp3", "text": "The way", "dur": 2.5, "kind": "spoken", "poem": "Hot Minute"}]}}